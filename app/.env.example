# LLM provider
# Packy / Claude Code CLI compatible
LLM_PROVIDER=claude-cli
ANTHROPIC_BASE_URL=https://www.packyapi.com
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL_CHAT=claude-sonnet-4-6
# Claude CLI 子进程超时：抽取默认 180s，渲染默认 600s。
LLM_CLAUDE_CLI_TIMEOUT_MS=180000
LLM_CLAUDE_CLI_RENDER_TIMEOUT_MS=600000
# 知识类研究固定优先使用 Claude CLI 的 WebSearch/WebFetch。
# 联网失败默认终止任务，避免旧知识冒充最新信息；仅在明确接受离线内容时开启降级。
LLM_CLAUDE_CLI_RESEARCH_TIMEOUT_MS=180000
LLM_KNOWLEDGE_RESEARCH_MODEL=claude-sonnet-4-6
LLM_KNOWLEDGE_RESEARCH_TOOLS=WebSearch,WebFetch
LLM_KNOWLEDGE_RESEARCH_MAX_TURNS=6
# KNOWLEDGE_ALLOW_OFFLINE_FALLBACK=false

# Anthropic Messages API HTTP compatible（Packy 当前会拒绝普通 HTTP 调用）
# LLM_PROVIDER=anthropic-compatible

# DeepSeek / OpenAI-compatible（如需切回，设置 LLM_PROVIDER=openai-compatible）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_CHAT=deepseek-chat
# LLM_MODEL_REASONER=deepseek-reasoner

# 一期占位，留空即可（旅游类走 SVG fallback）
# M2 接入高德实地图时填入。申请：https://lbs.amap.com 控制台 → Web 服务 API
AMAP_KEY=

# Playwright 截图时访问 preview 页用的 base URL
SNAPSHOT_BASE_URL=http://localhost:3000

# Image generation provider
# PackyAPI / GPT Image
IMAGE_PACKY_API_KEY=
PACKY_API_KEY=
IMAGE_PACKY_MODEL=gpt-image-2
IMAGE_PACKY_BASE_URL=https://www.packyapi.com
IMAGE_PACKY_ENDPOINT=/v1/images/generations
IMAGE_PACKY_RESPONSE_FORMAT=url

# 千问 / DashScope
DASHSCOPE_API_KEY=
IMAGE_QWEN_API_KEY=
IMAGE_QWEN_MODEL=qwen-image
IMAGE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_QWEN_ENDPOINT=/services/aigc/multimodal-generation/generation

# 豆包 / Seedream（火山方舟或兼容代理）
IMAGE_DOUBAO_API_KEY=
ARK_API_KEY=
IMAGE_DOUBAO_MODEL=doubao-seedream-3-0-t2i-250415
IMAGE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_DOUBAO_ENDPOINT=/images/generations
IMAGE_DOUBAO_RESPONSE_FORMAT=url
